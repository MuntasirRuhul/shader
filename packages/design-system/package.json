{
  "name": "@shader/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens, theming, and accessible UI primitives. Depends on nothing in the application.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/generated/tokens.css"
  },
  "scripts": {
    "build:tokens": "tsx src/tokens/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
